---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Trans from '../components/Trans.astro';
import { ui } from '../i18n/ui';

interface Props {
  titleEs?: string;
  titleEn?: string;
}

const {
  titleEs = ui.es['site.title'],
  titleEn = ui.en['site.title'],
} = Astro.props;
---

<!doctype html>
<html
  lang="es"
  class="dark"
  data-title-es={titleEs}
  data-title-en={titleEn}
>
  <head>
    <meta charset="utf-8" />
    <!-- Default favicon (sky-colored logo, universal fallback) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Dark-mode browser chrome: white-content logo stands out on dark tab bar -->
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: dark)" />
    <!-- Light-mode browser chrome: black-content logo stands out on light tab bar -->
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: light)" />
    <!-- ICO fallback for legacy browsers -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="MjhJOdX3LyE8Jkbx6PPvpCGo0YK4Bqs3SMCkcodYu-o" />
    <title>{titleEs}</title>

    <!-- Early inline script to prevent language / title flash before paint -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('site-lang');
          var lang = 'es';
          if (stored === 'es' || stored === 'en') {
            lang = stored;
          } else {
            var navLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
            if (navLang.startsWith('en')) {
              lang = 'en';
            } else {
              lang = 'es';
            }
          }
          document.documentElement.lang = lang;

          var root = document.documentElement;
          var title = lang === 'en' ? root.dataset.titleEn : root.dataset.titleEs;
          if (title) {
            document.title = title;
          }
        } catch (e) {
          document.documentElement.lang = 'es';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans bg-neutral-950 text-neutral-100 antialiased flex flex-col selection:bg-sky-500 selection:text-neutral-950 relative">
    <!-- Atmospheric subtle background glow in blue/sky tones over deep neutral dark -->
    <div
      class="fixed inset-0 -z-10 h-full w-full pointer-events-none bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(14,165,233,0.12),rgba(255,255,255,0))]"
      aria-hidden="true"
    ></div>

    <!-- Skip to content accessible link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-neutral-900 focus:text-sky-400 focus:border focus:border-neutral-700 focus:rounded-lg focus:outline-hidden"
    >
      <Trans k="nav.skipToContent" />
    </a>

    <Header />

    <main id="main-content" class="flex-1 max-w-5xl mx-auto px-4 py-12 w-full">
      <slot />
    </main>

    <Footer />
  </body>
</html>




