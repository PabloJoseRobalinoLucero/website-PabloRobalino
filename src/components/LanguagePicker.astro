---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type SupportedLanguage } from '../i18n/ui';

interface Props {
  currentLocale: SupportedLanguage;
}

const { currentLocale } = Astro.props;
---

<nav aria-label="Selector de idioma / Language selector" class="inline-flex items-center gap-1 p-1 rounded-lg bg-slate-900 border border-slate-800 text-xs sm:text-sm font-medium">
  {
    (Object.keys(languages) as SupportedLanguage[]).map((lang) => {
      const isActive = lang === currentLocale;
      const targetUrl = getRelativeLocaleUrl(lang, '/');

      return (
        <a
          href={targetUrl}
          aria-current={isActive ? 'page' : undefined}
          class={`px-3 py-1.5 rounded-md transition-all duration-200 ${
            isActive
              ? 'bg-sky-500 text-slate-950 font-semibold shadow-sm shadow-sky-500/25'
              : 'text-slate-400 hover:text-sky-300 hover:bg-slate-800/80'
          }`}
        >
          {languages[lang]}
        </a>
      );
    })
  }
</nav>

