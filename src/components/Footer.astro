---
import Trans from './Trans.astro';
import LinkedIn from './icons/LinkedIn.astro';
import GitHub from './icons/GitHub.astro';
import Mail from './icons/Mail.astro';


const footerLinks = [
  { href: '/', key: 'nav.home' as const },
  { href: '/about', key: 'nav.about' as const },
  { href: '/portfolio', key: 'nav.portfolio' as const },
  { href: '/experience', key: 'nav.experience' as const },
  { href: '/talks', key: 'nav.talks' as const },
  { href: '/community', key: 'nav.community' as const },
  { href: '/contact', key: 'nav.contact' as const },
];

const startYear = 2026;
const currentYear = new Date().getFullYear();
const copyrightYear = currentYear > startYear ? `${startYear}–${currentYear}` : `${startYear}`;
---

<footer class="border-t border-neutral-800/60 py-8 text-sm text-neutral-500 mt-auto">
  <div class="max-w-5xl mx-auto px-4 flex flex-col gap-6">
    <!-- Top row: Nav links inline -->
    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Navegación del pie de página">
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            class="text-neutral-400 hover:text-sky-300 transition-colors"
          >
            <Trans k={link.key} />
          </a>
        ))
      }
    </nav>

    <!-- Bottom row: Social icons + copyright -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-neutral-900">
      <div class="flex items-center gap-5">
        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/pablo-robalino-lucero/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-neutral-400 hover:text-sky-300 transition-colors"
        >
          <LinkedIn class="w-5 h-5" aria-hidden="true" />
        </a>
        <!-- GitHub -->
        <a
          href="https://github.com/PabloRobalino"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="text-neutral-400 hover:text-sky-300 transition-colors"
        >
          <!-- TODO: verify official GitHub URL -->
          <GitHub class="w-5 h-5" aria-hidden="true" />
        </a>
        <!-- Email -->
        <a
          href="mailto:pablorobalinotrabajo@hotmail.com"
          aria-label="Email"
          class="text-neutral-400 hover:text-sky-300 transition-colors"
        >
          <Mail class="w-5 h-5" aria-hidden="true" />
        </a>
      </div>

      <div>
        <span class="text-neutral-500">&copy; {copyrightYear} Pablo Robalino</span>
      </div>
    </div>
  </div>
</footer>
