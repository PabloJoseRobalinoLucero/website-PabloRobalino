---
---

<div
  role="group"
  aria-label="Seleccionar idioma / Select language"
  class="inline-flex items-center gap-1 p-1 rounded-lg bg-neutral-900/80 border border-neutral-800/70 text-xs font-medium"
>
  <button
    type="button"
    data-lang-btn="es"
    aria-pressed="false"
    class="lang-btn px-2.5 py-1 rounded-md transition-colors duration-150 cursor-pointer text-neutral-400 hover:text-sky-300 hover:bg-neutral-800/80"
  >
    ES
  </button>
  <button
    type="button"
    data-lang-btn="en"
    aria-pressed="false"
    class="lang-btn px-2.5 py-1 rounded-md transition-colors duration-150 cursor-pointer text-neutral-400 hover:text-sky-300 hover:bg-neutral-800/80"
  >
    EN
  </button>
</div>

<script>
  type SupportedLanguage = 'es' | 'en';

  const ACTIVE_CLASSES = [
    'bg-sky-500',
    'text-neutral-950',
    'font-semibold',
  ];
  const INACTIVE_CLASSES = [
    'text-neutral-400',
    'hover:text-sky-300',
    'hover:bg-neutral-800/80',
  ];

  function updateActiveUI(lang: SupportedLanguage) {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
    buttons.forEach((btn) => {
      const btnLang = btn.getAttribute('data-lang-btn');
      const isActive = btnLang === lang;
      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');

      if (isActive) {
        btn.classList.add(...ACTIVE_CLASSES);
        btn.classList.remove(...INACTIVE_CLASSES);
      } else {
        btn.classList.remove(...ACTIVE_CLASSES);
        btn.classList.add(...INACTIVE_CLASSES);
      }
    });

    const root = document.documentElement;
    const title = lang === 'en' ? root.dataset.titleEn : root.dataset.titleEs;
    if (title) {
      document.title = title;
    }
  }

  function setLanguage(lang: SupportedLanguage) {
    try {
      localStorage.setItem('site-lang', lang);
    } catch (e) {
      // localStorage might be disabled
    }
    document.documentElement.lang = lang;
    updateActiveUI(lang);
  }

  function initLanguageToggle() {
    const currentLang = (document.documentElement.lang || 'es') as SupportedLanguage;
    updateActiveUI(currentLang === 'en' ? 'en' : 'es');

    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetLang = btn.getAttribute('data-lang-btn') as SupportedLanguage;
        if (targetLang) {
          setLanguage(targetLang);
        }
      });
    });
  }

  initLanguageToggle();
  document.addEventListener('astro:page-load', initLanguageToggle);
</script>
