---
import Layout from '../layouts/Layout.astro';
import Trans from '../components/Trans.astro';
import { ui } from '../i18n/ui';
---

<Layout titleEs={ui.es['contact.title']} titleEn={ui.en['contact.title']}>
  <div class="space-y-12">
    <!-- Page Header -->
    <header class="space-y-2 border-b border-neutral-800/70 pb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-100">
        <Trans k="contact.pageTitle" />
      </h1>
      <p class="text-base text-neutral-400">
        <Trans k="contact.pageDescription" />
      </p>
    </header>

    <!-- Main Contact Information (No boxes, large clean typography) -->
    <section class="space-y-8">
      <!-- Email -->
      <div class="space-y-1">
        <p class="uppercase tracking-widest text-xs font-semibold text-neutral-500">
          <Trans k="contact.email" />
        </p>
        <div>
          <a
            href="mailto:pablorobalinotrabajo@hotmail.com"
            class="text-xl sm:text-2xl md:text-3xl font-semibold text-sky-400 hover:text-sky-300 transition-colors break-all"
          >
            pablorobalinotrabajo@hotmail.com
          </a>
        </div>
      </div>

      <!-- Location -->
      <div class="space-y-1">
        <p class="uppercase tracking-widest text-xs font-semibold text-neutral-500">
          <Trans k="contact.location" />
        </p>
        <p class="text-lg text-neutral-200">
          <Trans k="contact.locationValue" />
        </p>
      </div>

      <!-- Professional Networks -->
      <div class="space-y-3">
        <p class="uppercase tracking-widest text-xs font-semibold text-neutral-500">
          <Trans k="contact.social" />
        </p>
        <div class="flex flex-wrap items-center gap-6 text-sm">
          <a
            href="https://www.linkedin.com/in/pablo-robalino-lucero/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-300 hover:text-sky-300 transition-colors inline-flex items-center gap-2"
          >
            <span>LinkedIn</span>
            <span class="text-neutral-600">↗</span>
          </a>

          <!-- TODO: verify official GitHub URL -->
          <a
            href="https://github.com/PabloJoseRobalinoLucero"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-300 hover:text-sky-300 transition-colors inline-flex items-center gap-2"
          >
            <span>GitHub</span>
            <span class="text-neutral-600">↗</span>
          </a>
        </div>
      </div>

      <!-- References Note -->
      <div class="pt-6 border-t border-neutral-800/70">
        <p class="text-sm text-neutral-500 italic">
          <Trans k="contact.references" />
        </p>
      </div>
    </section>
  </div>
</Layout>
