---
import Layout from '../layouts/Layout.astro';
import Trans from '../components/Trans.astro';
import { ui } from '../i18n/ui';
import { experiences } from '../data/experience';
import { formatPeriod } from '../i18n/utils';

const presentText = {
  es: ui.es['experience.present'],
  en: ui.en['experience.present'],
};
---

<Layout titleEs={ui.es['experience.title']} titleEn={ui.en['experience.title']}>
  <div class="space-y-12">
    <!-- Page Header -->
    <header class="space-y-2 border-b border-neutral-800/70 pb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-100">
        <Trans k="experience.pageTitle" />
      </h1>
      <p class="text-base text-neutral-400">
        <Trans k="experience.pageDescription" />
      </p>
    </header>

    <!-- Editorial List -->
    <div class="divide-y divide-neutral-800/70">
      {
        experiences.map((exp) => {
          const periodText = formatPeriod(exp.period, presentText);
          return (
            <article class="py-8 first:pt-0 last:pb-0 grid grid-cols-1 md:grid-cols-[9rem_1fr] gap-4 md:gap-6">
              <!-- Period -->
              <div class="text-sm text-neutral-500 font-mono pt-1">
                <Trans text={periodText} />
              </div>

              <!-- Details -->
              <div class="space-y-3">
                <div>
                  <h2 class="text-lg font-semibold text-neutral-100">
                    <Trans text={exp.position} />
                  </h2>
                  <div class="flex items-center gap-2 text-sm">
                    <span class="text-sky-400 font-medium">{exp.company}</span>
                    <span class="text-neutral-600">·</span>
                    <span class="text-xs text-neutral-500">{exp.location}</span>
                  </div>
                </div>

                <ul class="space-y-2 text-sm text-neutral-400 leading-relaxed">
                  {exp.bullets.map((bullet) => (
                    <li class="flex items-start gap-2">
                      <span class="text-neutral-600 select-none">–</span>
                      <span>
                        <Trans text={bullet} />
                      </span>
                    </li>
                  ))}
                </ul>

                <p class="text-xs text-neutral-500 pt-1">
                  {exp.tech.join(' · ')}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</Layout>
