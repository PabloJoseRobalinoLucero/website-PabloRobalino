---
import Layout from '../layouts/Layout.astro';
import LinkedIn from '../components/icons/LinkedIn.astro';
import GitHub from '../components/icons/GitHub.astro';
import Mail from '../components/icons/Mail.astro';

import Trans from '../components/Trans.astro';
import { projects } from '../data/projects';

const featuredProject = projects.find((p) => p.featured);
---

<Layout>
  <div class="space-y-16 py-4">
    <!-- Hero Editorial Section -->
    <section class="space-y-6">
      <div class="flex items-center gap-4">
        <!-- Profile photo -->
        <img
          src="/pablo-robalino.png"
          alt="Pablo Robalino"
          class="w-40 h-40 rounded-full object-cover object-top border border-white/10"
        />
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-100">
        <Trans k="hero.title" />
      </h1>

      <p class="text-base sm:text-lg text-neutral-400 leading-relaxed max-w-3xl">
        <Trans k="hero.description" />
      </p>

      <!-- Action buttons & email link -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <!-- Availability badge -->
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 text-neutral-200 text-sm">
          <span class="relative flex h-2 w-2 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <Trans k="hero.available" />
        </span>

        <a
          href="https://www.linkedin.com/in/pablo-robalino-lucero/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 text-neutral-200 text-sm hover:scale-105 hover:bg-white/10 hover:border-sky-500/40 hover:text-sky-300 transition-all"
        >
          <LinkedIn class="w-4 h-4 fill-currentColor" aria-hidden="true" />
          <Trans k="hero.linkedin" />
        </a>

        <!-- TODO: verify official GitHub URL -->
        <a
          href="https://github.com/PabloRobalino"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 text-neutral-200 text-sm hover:scale-105 hover:bg-white/10 hover:border-sky-500/40 hover:text-sky-300 transition-all"
        >
          <GitHub class="w-4 h-4 fill-currentColor" aria-hidden="true" />
          <Trans k="hero.github" />
        </a>

        <a
          href="mailto:pablorobalinotrabajo@hotmail.com"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 text-neutral-200 text-sm hover:scale-105 hover:bg-white/10 hover:border-sky-500/40 hover:text-sky-300 transition-all"
        >
          <Mail class="w-4 h-4" aria-hidden="true" />
          <span>pablorobalinotrabajo@hotmail.com</span>
        </a>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="py-8 border-y border-neutral-800/60">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
        <div>
          <p class="text-3xl font-semibold text-neutral-100">18+</p>
          <p class="text-xs text-neutral-500 mt-1"><Trans k="stats.talks" /></p>
        </div>
        <div class="sm:border-l sm:border-neutral-800/60 sm:pl-8">
          <p class="text-3xl font-semibold text-neutral-100">30+</p>
          <p class="text-xs text-neutral-500 mt-1"><Trans k="stats.events" /></p>
        </div>
        <div class="border-t border-neutral-800/60 pt-6 sm:border-t-0 sm:pt-0 sm:border-l sm:border-neutral-800/60 sm:pl-8">
          <p class="text-3xl font-semibold text-neutral-100">3+</p>
          <p class="text-xs text-neutral-500 mt-1"><Trans k="stats.experience" /></p>
        </div>
        <div class="border-t border-neutral-800/60 pt-6 sm:border-t-0 sm:pt-0 sm:border-l sm:border-neutral-800/60 sm:pl-8">
          <p class="text-3xl font-semibold text-neutral-100">16</p>
          <p class="text-xs text-neutral-500 mt-1"><Trans k="stats.leadership" /></p>
        </div>
      </div>
    </section>

    <!-- Featured Project Section (Editorial format, no card box) -->
    {
      featuredProject && (
        <section class="space-y-4">
          <p class="uppercase tracking-widest text-xs font-semibold text-neutral-500">
            <Trans k="projects.featured" />
          </p>

          <article class="space-y-3">
            <h2 class="text-2xl font-bold text-neutral-100">
              <a
                href={`/portfolio/${featuredProject.slug}`}
                class="hover:text-sky-300 transition-colors"
              >
                <Trans text={featuredProject.title} />
              </a>
            </h2>

            <p class="text-sky-300 text-sm">
              <Trans text={featuredProject.tagline} />
            </p>

            <p class="text-neutral-400 text-sm leading-relaxed max-w-3xl">
              <Trans text={featuredProject.description} />
            </p>

            <p class="text-xs text-neutral-500 pt-1">
              {featuredProject.tech.join(' · ')}
            </p>

            <div>
              <a
                href={`/portfolio/${featuredProject.slug}`}
                class="inline-flex items-center text-sm text-sky-400 hover:text-sky-300 transition-colors"
              >
                <Trans k="projects.viewProject" />
              </a>
            </div>
          </article>
        </section>
      )
    }
  </div>
</Layout>


