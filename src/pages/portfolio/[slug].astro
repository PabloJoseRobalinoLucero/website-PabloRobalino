---
import Layout from '../../layouts/Layout.astro';
import Trans from '../../components/Trans.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const categoryLabels: Record<string, { es: string; en: string }> = {
  iot: { es: 'IoT', en: 'IoT' },
  web: { es: 'Web', en: 'Web' },
  software: { es: 'Software', en: 'Software' },
};
---

<Layout
  titleEs={`${project.title.es} | Pablo Robalino`}
  titleEn={`${project.title.en} | Pablo Robalino`}
>
  <div class="space-y-10">
    <!-- Back Link -->
    <div>
      <a
        href="/portfolio"
        class="inline-flex items-center text-sm text-neutral-400 hover:text-sky-300 transition-colors"
      >
        <Trans k="portfolio.back" />
      </a>
    </div>

    <!-- Project Header -->
    <header class="space-y-3 border-b border-neutral-800/70 pb-8">
      <div class="flex items-center gap-2 text-xs text-neutral-500 uppercase tracking-wider">
        <span>{project.year}</span>
        <span>·</span>
        <span>
          <Trans text={categoryLabels[project.category] ?? { es: project.category, en: project.category }} />
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-100">
        <Trans text={project.title} />
      </h1>

      <p class="text-lg text-sky-300">
        <Trans text={project.tagline} />
      </p>
    </header>

    <!-- Description -->
    <section class="space-y-4">
      <div class="text-base text-neutral-300 leading-relaxed max-w-3xl">
        <Trans as="p" text={project.description} />
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="space-y-3 pt-4 border-t border-neutral-800/70">
      <h2 class="uppercase tracking-widest text-xs font-semibold text-neutral-500">
        <Trans k="portfolio.tech" />
      </h2>
      <p class="text-sm text-neutral-400">
        {project.tech.join(' · ')}
      </p>
    </section>

    <!-- Links if available -->
    {
      project.links && (project.links.demo || project.links.repo) && (
        <section class="pt-4 flex items-center gap-4">
          {project.links.demo && (
            <a
              href={project.links.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 text-neutral-200 text-sm hover:scale-105 hover:bg-white/10 hover:border-sky-500/40 hover:text-sky-300 transition-all"
            >
              <Trans k="portfolio.liveDemo" /> →
            </a>
          )}
          {project.links.repo && (
            <a
              href={project.links.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 text-neutral-200 text-sm hover:scale-105 hover:bg-white/10 hover:border-sky-500/40 hover:text-sky-300 transition-all"
            >
              <Trans k="portfolio.sourceCode" /> →
            </a>
          )}
        </section>
      )
    }
  </div>
</Layout>
